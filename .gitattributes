# Normalize text across Windows, macOS, and Linux
* text=auto

# Scripts use Unix line endings
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts use Windows line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat common audio and image assets as binary
*.wav binary
*.aif binary
*.aiff binary
*.flac binary
*.mp3 binary
*.ogg binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
